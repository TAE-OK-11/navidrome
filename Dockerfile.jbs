# syntax=docker/dockerfile:1.25

# JBS Networks Navidrome optimized image
# - Go 1.26.5 / Node 26.5
# - GOAMD64=v3, clang/lld, full LTO
# - Go PGO using Navidrome hot-path benchmarks
# - jemalloc runtime
# - FFmpeg 8.1.x-compatible Debian runtime
# - precompressed UI assets (Brotli/Zstd/gzip generated by the UI build)
# - cgroup-aware runtime autotuning

ARG DEBIAN_IMAGE=debian:trixie-slim
ARG NODE_IMAGE=node:26.5.0-trixie-slim
ARG GOLANG_IMAGE=golang:1.26.5-trixie

ARG NAVIDROME_BUILD_CORES=4
ARG GOAMD64_VERSION=v3
ARG GO_PGO_ENABLED=true
ARG GO_PGO_BENCHTIME=500ms
ARG GOGC=125
ARG GOMEMLIMIT=auto
ARG GOMAXPROCS=auto
ARG FFMPEG_THREADS=auto

# -----------------------------------------------------------------------------
# UI
# -----------------------------------------------------------------------------
FROM ${NODE_IMAGE} AS ui
ARG NAVIDROME_BUILD_CORES
WORKDIR /src/ui
ENV NODE_OPTIONS=--max-old-space-size=2048 \
    ND_UI_SOURCEMAP=false \
    STATIC_COMPRESSION_JOBS=${NAVIDROME_BUILD_CORES} \
    UV_THREADPOOL_SIZE=${NAVIDROME_BUILD_CORES}

COPY ui/package.json ui/package-lock.json ./
COPY ui/bin ./bin
RUN --mount=type=cache,target=/root/.npm,sharing=locked \
    npm ci --prefer-offline --no-audit --fund=false
COPY ui ./
RUN --mount=type=cache,target=/root/.npm,sharing=locked \
    npm run build && \
    test -s build/index.html && \
    test -n "$(find build -type f -name '*.br' -print -quit)" && \
    test -n "$(find build -type f -name '*.zst' -print -quit)" && \
    test -n "$(find build -type f -name '*.gz' -print -quit)" && \
    test -z "$(find build -type f -name '*.map' -print -quit)"

# -----------------------------------------------------------------------------
# Go builder
# -----------------------------------------------------------------------------
FROM ${GOLANG_IMAGE} AS builder
ARG NAVIDROME_BUILD_CORES
ARG GOAMD64_VERSION
ARG GO_PGO_ENABLED
ARG GO_PGO_BENCHTIME
ARG GIT_SHA=dev
ARG GIT_TAG=jbs

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates clang lld llvm file gcc g++ libc6-dev zlib1g-dev pkg-config && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY go.mod go.sum ./
ENV GOTOOLCHAIN=local GOFLAGS=-mod=readonly
RUN --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    go mod download && go mod verify

COPY . ./
COPY --from=ui /src/ui/build ./ui/build

ENV GOAMD64=${GOAMD64_VERSION} \
    CGO_ENABLED=1 \
    CC=clang \
    CXX=clang++ \
    CGO_CFLAGS="-O3 -march=znver3 -mtune=znver3 -DNDEBUG -ffunction-sections -fdata-sections -fno-semantic-interposition -pipe -fno-plt -flto=full" \
    CGO_CXXFLAGS="-O3 -march=znver3 -mtune=znver3 -DNDEBUG -ffunction-sections -fdata-sections -fno-semantic-interposition -pipe -fno-plt -flto=full" \
    CGO_LDFLAGS="-flto=full -fuse-ld=lld -Wl,-O2 -Wl,--lto-O3 -Wl,--gc-sections -Wl,--icf=safe -Wl,--as-needed -Wl,-z,relro,-z,now"

RUN --mount=type=cache,target=/root/.cache/go-build,sharing=locked \
    --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    set -eux; \
    mkdir -p /tmp/pgo; \
    if [ "${GO_PGO_ENABLED}" = "true" ]; then \
      BUILD_TAGS='netgo osusergo sqlite_fts5 sqlite_foreign_keys sqlite_stat4 embed'; \
      train() { \
        name="$1"; package="$2"; benchmark="$3"; benchtime="$4"; \
        if go test -run='^$' -bench="${benchmark}" -benchtime="${benchtime}" -count=1 \
          -tags="${BUILD_TAGS}" -cpuprofile="/tmp/pgo/${name}.pprof" "${package}"; then \
          test -s "/tmp/pgo/${name}.pprof"; \
        else \
          rm -f "/tmp/pgo/${name}.pprof"; \
        fi; \
      }; \
      train compression ./server '^BenchmarkCompressionLargeSingleWrite$' "${GO_PGO_BENCHTIME}"; \
      train api ./server/subsonic '^BenchmarkSubsonicJSONMarshal$' "${GO_PGO_BENCHTIME}"; \
      train scanner ./scanner '^BenchmarkScan$' 250ms; \
      profiles="$(find /tmp/pgo -type f -name '*.pprof' -size +0c -print)"; \
      if [ -n "$profiles" ]; then \
        go tool pprof -proto -output=/tmp/default.pgo $profiles; \
      fi; \
    fi

RUN --mount=type=cache,target=/root/.cache/go-build,sharing=locked \
    --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    set -eux; \
    if [ -s /tmp/default.pgo ]; then PGO='-pgo=/tmp/default.pgo'; else PGO='-pgo=off'; fi; \
    BUILD_TAGS='netgo osusergo sqlite_fts5 sqlite_foreign_keys sqlite_stat4 embed'; \
    EXTLDFLAGS='-flto=full -fuse-ld=lld -Wl,-O2 -Wl,--lto-O3 -Wl,--gc-sections -Wl,--icf=safe -Wl,--as-needed -Wl,-z,relro,-z,now'; \
    go build -p "${NAVIDROME_BUILD_CORES}" ${PGO} -trimpath -buildvcs=false \
      -tags="${BUILD_TAGS}" \
      -ldflags="-linkmode=external -extld=clang -extldflags '${EXTLDFLAGS}' -s -w -buildid= -X github.com/navidrome/navidrome/consts.gitSha=${GIT_SHA} -X github.com/navidrome/navidrome/consts.gitTag=${GIT_TAG}" \
      -o /out/navidrome .; \
    file /out/navidrome; \
    go version -m /out/navidrome

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
FROM ${DEBIAN_IMAGE} AS release
ARG GOGC
ARG GOMEMLIMIT
ARG GOMAXPROCS
ARG FFMPEG_THREADS

LABEL org.opencontainers.image.title="JBS Navidrome" \
      org.opencontainers.image.vendor="JBS Networks" \
      org.opencontainers.image.source="https://github.com/TAE-OK-11/navidrome" \
      jbs.optimization="GOAMD64-v3/Go-PGO/LLVM-full-LTO/jemalloc/Zstd-Brotli-gzip/HTTP3"

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates ffmpeg libjemalloc2 libwebp7 libwebpdemux2 tzdata && \
    rm -rf /var/lib/apt/lists/* /usr/share/doc /usr/share/man /usr/share/info

RUN printf '%s\n' 'navidrome:x:1000:1000:Navidrome:/nonexistent:/usr/sbin/nologin' >> /etc/passwd && \
    printf '%s\n' 'navidrome:x:1000:' >> /etc/group && \
    install -d -o 1000 -g 1000 -m 755 /app /data /music /cache /cache/tmp /cache/hot-music

COPY --from=builder --chown=1000:1000 --chmod=750 /out/navidrome /app/navidrome

RUN cat > /usr/local/bin/jbs-entrypoint <<'SH'
#!/bin/sh
set -eu

is_auto() {
  case "${1:-}" in ""|auto|AUTO|Auto) return 0 ;; *) return 1 ;; esac
}
valid_uint() {
  case "${1:-}" in ""|*[!0-9]*) return 1 ;; *) return 0 ;; esac
}

cores="$(nproc 2>/dev/null || echo 1)"
if [ -r /sys/fs/cgroup/cpu.max ]; then
  read -r quota period < /sys/fs/cgroup/cpu.max || true
  if valid_uint "${quota:-}" && valid_uint "${period:-}" && [ "$period" -gt 0 ] && [ "$quota" -gt 0 ]; then
    qcores=$(( (quota + period - 1) / period ))
    [ "$qcores" -lt "$cores" ] && cores="$qcores"
  fi
fi
[ "$cores" -lt 1 ] && cores=1

mem_mib=0
if [ -r /sys/fs/cgroup/memory.max ]; then
  read -r max < /sys/fs/cgroup/memory.max || true
  if valid_uint "${max:-}" && [ "$max" -gt 0 ] && [ "$max" -lt 9223372036854771712 ]; then
    mem_mib=$(( max / 1048576 ))
  fi
fi
if [ "$mem_mib" -eq 0 ]; then
  mem_mib="$(awk '/MemTotal:/ {print int($2/1024); exit}' /proc/meminfo)"
fi

if is_auto "${GOMAXPROCS:-}"; then
  [ "$cores" -gt 4 ] && cores=4
  export GOMAXPROCS="$cores"
fi
if is_auto "${GOMEMLIMIT:-}"; then
  target=$(( mem_mib * 55 / 100 ))
  [ "$target" -lt 64 ] && target=64
  [ "$target" -gt 4096 ] && target=4096
  export GOMEMLIMIT="${target}MiB"
fi
if is_auto "${FFMPEG_THREADS:-}"; then
  threads=$(( cores / 2 ))
  [ "$threads" -lt 1 ] && threads=1
  [ "$threads" -gt 2 ] && threads=2
  export FFMPEG_THREADS="$threads"
fi

for dir in "${ND_DATAFOLDER:-/data}" "${ND_CACHEFOLDER:-/cache}"; do
  [ -d "$dir" ] && [ -w "$dir" ] || { echo "non-writable runtime directory: $dir" >&2; exit 1; }
done

if [ -r /usr/lib/x86_64-linux-gnu/libjemalloc.so.2 ]; then
  export LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libjemalloc.so.2
fi

exec /app/navidrome "$@"
SH
RUN chmod 755 /usr/local/bin/jbs-entrypoint

USER 1000:1000
VOLUME ["/data", "/music", "/cache"]

ENV TZ=Asia/Seoul \
    TMPDIR=/cache/tmp \
    GOGC=${GOGC} \
    GOMEMLIMIT=${GOMEMLIMIT} \
    GOMAXPROCS=${GOMAXPROCS} \
    FFMPEG_THREADS=${FFMPEG_THREADS} \
    GODEBUG=netdns=go,madvdontneed=1 \
    MALLOC_CONF="background_thread:true,metadata_thp:disabled,narenas:2,dirty_decay_ms:5000,muzzy_decay_ms:10000,oversize_threshold:8388608,retain:false" \
    ND_ADDRESS=0.0.0.0 \
    ND_PORT=4533 \
    ND_MUSICFOLDER=/music \
    ND_DATAFOLDER=/data \
    ND_CACHEFOLDER=/cache \
    ND_FFMPEGPATH=/usr/bin/ffmpeg \
    ND_ENABLEHTTP3=false \
    ND_ENABLESCHEDULEDDBANALYZE=true \
    ND_SEARCH_BACKEND=fts \
    ND_TRANSCODING_ENABLECANCELLATION=true \
    ND_TRANSCODING_MAXCONCURRENT=1 \
    ND_TRANSCODING_MAXCONCURRENTPERUSER=1 \
    ND_TRANSCODINGCACHESIZE=2048MiB \
    ND_IMAGECACHESIZE=256MiB \
    ND_HOT_CACHE_ENABLED=true \
    ND_HOT_CACHE_PATH=/cache/hot-music \
    ND_HOT_CACHE_MAX_SIZE=3GiB \
    ND_HOT_CACHE_PROMOTE_ON_PLAY=true \
    ND_HOT_CACHE_PROMOTION_CONCURRENCY=1 \
    ND_HOT_CACHE_EVENTS_MAX=2000 \
    ND_ENABLELOGREDACTING=true \
    ND_ENABLEINSIGHTSCOLLECTOR=false

EXPOSE 4533/tcp 4533/udp
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=60s --timeout=5s --start-period=45s --retries=3 CMD ["/app/navidrome", "--help"]
WORKDIR /app
ENTRYPOINT ["/usr/local/bin/jbs-entrypoint"]
