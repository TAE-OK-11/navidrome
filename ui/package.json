{
  "name": "ui",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "vite build && bun bin/precompress-build-assets.ts",
    "serve": "vite preview",
    "test:watch": "vitest",
    "test": "vitest --watch=false",
    "test:coverage": "vitest run --coverage --watch=false",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx,js,jsx --report-unused-disable-directives --max-warnings 0",
    "prettier": "prettier --write ./src",
    "check-formatting": "prettier -c ./src",
    "postinstall": "bun bin/update-workbox.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@jsonforms/core": "3.8.0",
    "@jsonforms/material-renderers": "3.8.0",
    "@jsonforms/react": "3.8.0",
    "@mui/icons-material": "9.3.1",
    "@mui/lab": "9.0.0-beta.8",
    "@mui/material": "9.3.1",
    "@mui/styles": "6.4.8",
    "@mui/system": "9.3.0",
    "@mui/utils": "9.3.0",
    "@mui/x-date-pickers": "9.10.1",
    "blueimp-md5": "^2.19.0",
    "clsx": "^2.1.1",
    "deepmerge": "^4.3.1",
    "dompurify": "^3.4.13",
    "inflection": "^3.0.2",
    "jwt-decode": "^4.0.0",
    "lodash.throttle": "^4.1.1",
    "navidrome-music-player": "4.25.4",
    "prop-types": "^15.8.1",
    "ra-data-json-server": "5.15.0",
    "ra-i18n-polyglot": "5.15.0",
    "react": "19.2.8",
    "react-admin": "5.15.1",
    "react-dnd": "^14.0.5",
    "react-dnd-html5-backend": "^14.1.0",
    "react-dom": "19.2.8",
    "react-drag-listview": "^0.1.9",
    "react-ga": "^3.3.1",
    "react-hotkeys": "^2.0.0",
    "react-icons": "^5.7.0",
    "react-image-lightbox": "^5.1.4",
    "react-measure": "^2.5.2",
    "react-redux": "^7.2.9",
    "react-router-dom": "6.28.1",
    "redux": "^4.2.1",
    "uuid": "^13.0.2",
    "workbox-cli": "^7.4.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/react-hooks": "^7.0.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.9.1",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "happy-dom": "^20.11.2",
    "jsdom": "^26.1.0",
