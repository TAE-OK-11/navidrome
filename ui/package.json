{
  "name": "ui",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun node_modules/vite/bin/vite.js",
    "build": "bun node_modules/vite/bin/vite.js build && bun bin/precompress-build-assets.ts",
    "serve": "bun node_modules/vite/bin/vite.js preview",
    "test:watch": "bun node_modules/vitest/vitest.mjs",
    "test": "bun node_modules/vitest/vitest.mjs --watch=false",
    "test:coverage": "bun node_modules/vitest/vitest.mjs run --coverage --watch=false",
    "type-check": "bun node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.app.json && bun node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.node.json",
    "check:typescript-migration": "bun bin/check-typescript-migration.ts",
    "check:mui9": "bun bin/check-mui9-compat.ts",
    "lint": "bun node_modules/eslint/bin/eslint.js . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "prettier": "bun node_modules/prettier/bin/prettier.cjs --write ./src",
    "check-formatting": "bun node_modules/prettier/bin/prettier.cjs -c ./src",
    "postinstall": "bun bin/update-workbox.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@jsonforms/core": "3.8.0",
    "@jsonforms/material-renderers": "3.8.0",
    "@jsonforms/react": "3.8.0",
    "@mui/icons-material": "9.4.0",
    "@mui/lab": "9.0.0-beta.9",
    "@mui/material": "9.4.0",
    "@mui/system": "9.4.0",
    "@mui/utils": "9.4.0",
    "@mui/x-date-pickers": "9.12.0",
    "clsx": "^2.1.1",
    "deepmerge": "^4.3.1",
    "dompurify": "3.4.14",
    "inflection": "^3.0.2",
    "jwt-decode": "^4.0.0",
    "navidrome-music-player": "4.25.4",
    "ra-data-json-server": "5.15.0",
    "ra-i18n-polyglot": "5.15.0",
    "react": "19.2.8",
    "react-admin": "5.15.1",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-dom": "19.2.8",
    "react-drag-listview": "2.0.0",
    "react-final-form": "7.0.1",
    "react-ga4": "^3.0.1",
    "react-hotkeys-hook": "^5.2.1",
    "react-icons": "^5.7.0",
    "react-redux": "9.3.0",
    "react-router-dom": "7.18.2",
    "redux": "5.0.1",
    "uuid": "14.0.2",
    "workbox-cli": "^7.4.1",
    "yet-another-react-lightbox": "^3.29.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "happy-dom": "20.11.12",
    "jsdom": "29.1.1",
    "prettier": "^3.9.6",
    "typescript": "6.0.2",
    "vite": "8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "4.1.11"
  }
}
