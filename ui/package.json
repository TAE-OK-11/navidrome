{
  "name": "ui",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun node_modules/vite/bin/vite.js",
    "build": "bun node_modules/vite/bin/vite.js build && bun bin/precompress-build-assets.ts",
    "serve": "bun node_modules/vite/bin/vite.js preview",
    "test:watch": "bun node_modules/vitest/vitest.mjs",
    "test": "bun node_modules/vitest/vitest.mjs --watch=false",
    "test:coverage": "bun node_modules/vitest/vitest.mjs run --coverage --watch=false",
    "type-check": "bun node_modules/typescript/bin/tsc --noEmit",
    "check:mui9": "bun bin/check-mui9-compat.ts",
    "lint": "bun node_modules/eslint/bin/eslint.js . --ext ts,tsx,js,jsx --report-unused-disable-directives --max-warnings 0",
    "prettier": "bun node_modules/prettier/bin/prettier.cjs --write ./src",
    "check-formatting": "bun node_modules/prettier/bin/prettier.cjs -c ./src",
    "postinstall": "bun bin/update-workbox.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@jsonforms/core": "3.8.0",
    "@jsonforms/material-renderers": "3.8.0",
    "@jsonforms/react": "3.8.0",
    "@mui/icons-material": "9.3.1",
    "@mui/lab": "9.0.0-beta.8",
    "@mui/material": "9.3.1",
    "@mui/system": "9.3.0",
    "@mui/utils": "9.3.0",
    "@mui/x-date-pickers": "9.12.0",
    "blueimp-md5": "^2.19.0",
    "clsx": "^2.1.1",
    "deepmerge": "^4.3.1",
    "dompurify": "3.4.14",
    "inflection": "^3.0.2",
    "jwt-decode": "^4.0.0",
    "lodash.throttle": "^4.1.1",
    "navidrome-music-player": "4.25.4",
    "prop-types": "^15.8.1",
    "ra-data-json-server": "5.15.0",
    "ra-i18n-polyglot": "5.15.0",
    "react": "19.2.8",
    "react-admin": "5.15.1",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-dom": "19.2.8",
    "react-drag-listview": "2.0.0",
    "react-final-form": "7.0.1",
    "react-ga": "^3.3.1",
    "react-hotkeys": "^2.0.0",
    "react-icons": "^5.7.0",
    "react-image-lightbox": "^5.1.4",
    "react-measure": "^2.5.2",
    "react-redux": "9.3.0",
    "react-router-dom": "7.18.2",
    "redux": "5.0.1",
    "tss-react": "^4.9.21",
    "uuid": "14.0.2",
    "workbox-cli": "^7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.2.0",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "happy-dom": "20.11.6",
    "jsdom": "29.1.1",
    "prettier": "^3.9.6",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "4.1.11"
  }
}
